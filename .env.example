# The "Who can I contact?" finder (app/api/contacts). Copy these lines to .env.local (git-ignored) and fill
# them in there; never put a real key in this file or commit it.
OPENAI_API_KEY=
# The model it asks: a good, cheap model with web search. Every live test of the finder used this one.
OPENAI_MODEL=gpt-6-luna
# How many proxies in front of the server append the visitor's address to X-Forwarded-For (often 1 on a
# hosting platform; check one request's header to be sure). 0 trusts none: every visitor shares one limit.
CONTACTS_TRUSTED_PROXY_HOPS=0
# New searches (OpenAI calls) per hour for the whole server, whoever asks. Repeated questions are free.
CONTACTS_MAX_SEARCHES_PER_HOUR=30
# Optional: identify RareVerse to NCBI when reading PubMed (each is sent only when set).
# NCBI_TOOL=rareverse
# NCBI_EMAIL=
