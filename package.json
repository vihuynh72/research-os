    "typecheck": "tsc --noEmit",
    "check:schema": "node scripts/check-schema.mjs",
    "data:sample": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-to-graph.ts",
    "data:hpo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-hpo-reference.ts",
    "grade": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/grade.ts",
    "grade:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/grade.ts --check",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"lib/**/*.test.ts\" \"components/**/*.test.ts\""
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "next": "^16.3.8",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
